@@ -0,0 +1,17 @@
+// Compatibility for the documented $media.file API, absent from EmDash 1.4.0.
+export async function localSeedResponse(file, basePath) {
+  if (!basePath) throw new Error('$media.file requires mediaBasePath');
+  const { realpath, readFile } = await import('node:fs/promises');
+  const { resolve, relative, isAbsolute, sep } = await import('node:path');
+  const { default: mime } = await import('mime/lite');
+  if (isAbsolute(file)) throw new Error('$media.file must be relative');
+  const base = await realpath(basePath);
+  const target = await realpath(resolve(base, file));
+  const within = relative(base, target);
+  if (within === '..' || within.startsWith(`..${sep}`) || isAbsolute(within)) {
+    throw new Error('$media.file escapes the seed directory');
+  }
+  return new Response(await readFile(target), {
+    headers: { 'content-type': mime.getType(target) ?? 'application/octet-stream' },
+  });
+}

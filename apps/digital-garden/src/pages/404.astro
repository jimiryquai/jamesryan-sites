---
import Base from "../layouts/Base.astro";
import FuzzyRedirect from "@jdevalk/astro-seo-graph/FuzzyRedirect.astro";
import Container from "@jamesryan/ui/components/elements/container.astro";
import Eyebrow from "@jamesryan/ui/components/elements/eyebrow.astro";
import Heading from "@jamesryan/ui/components/elements/heading.astro";
import Text from "@jamesryan/ui/components/elements/text.astro";
import ButtonLink from "@jamesryan/ui/components/elements/ButtonLink.astro";
import PlainButtonLink from "@jamesryan/ui/components/elements/PlainButtonLink.astro";
---

<Base title="Page not found">
	<Container class="py-24 text-center">
		<Eyebrow class="!font-display !text-8xl/none !tracking-tight !text-olive-300 dark:!text-olive-600">404</Eyebrow>
		<Heading class="mt-6">Page not found</Heading>
		<Text size="lg" class="mx-auto mt-4 max-w-xl">The page you're looking for doesn't exist or has been moved.</Text>
		<div class="mx-auto mt-8 inline-block rounded-2xl border border-olive-950/10 bg-olive-50 px-6 py-4 text-olive-950 dark:border-white/10 dark:bg-olive-900 dark:text-olive-100 [&_a]:font-medium [&_a]:text-olive-950 [&_a]:underline dark:[&_a]:text-white">
			<FuzzyRedirect sitemapUrl="/sitemap.xml" />
		</div>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
			<ButtonLink href="/" size="lg">Go home</ButtonLink>
			<PlainButtonLink href="/contact" size="lg">Contact us</PlainButtonLink>
		</div>
	</Container>
</Base>

---
import type { ComponentProps } from "astro/types";
import SharedBase from "@jamesryan/ui/components/Base.astro";
import UsermavenAnalytics from "../components/UsermavenAnalytics.astro";
import "../styles/globals.css";

type Props = ComponentProps<typeof SharedBase>;

const props = Astro.props;
---
<SharedBase {...props}>
	<slot />
	<Fragment slot="links">
		<slot name="links" />
		<UsermavenAnalytics />
	</Fragment>
</SharedBase>

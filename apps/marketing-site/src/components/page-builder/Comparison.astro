---
import type { StoredBlock } from 'emdash-plugin-page-builder/blocks';
import MarketingComparison from '../blocks/Comparison.astro';
interface Props { value: StoredBlock }
const value = Astro.props.value as StoredBlock & {
  rows?: { group_name?: string; name?: string; first_value?: string; second_value?: string; third_value?: string }[];
};
// Column keys are positions (first/second/third); the site's comparison visual is
// the marketing table, whose plan headers are Starter/Growth/Pro.
---
<MarketingComparison node={{
  _key: value._key,
  items: (value.rows ?? []).map((row) => ({
    groupName: row.group_name ?? '',
    name: row.name ?? '',
    starterValue: row.first_value ?? '',
    growthValue: row.second_value ?? '',
    proValue: row.third_value ?? '',
  })),
}} />

---
import type { Faq as FaqShape, StoredBlock } from 'emdash-plugin-page-builder/blocks';
import FAQsAccordion from '@jamesryan/ui/components/sections/FAQsAccordion.astro';
import FAQsTwoColumnAccordion from '@jamesryan/ui/components/sections/FAQsTwoColumnAccordion.astro';
import Faq from '@jamesryan/ui/components/sections/Faq.astro';
interface Props { value: StoredBlock; items?: readonly unknown[] }
const value = Astro.props.value as StoredBlock & { variant?: 'two-column' | 'centered' };
// PageBuilder resolves this block's typed source before entering the generic section boundary.
const items = (Astro.props.items ?? []) as readonly FaqShape[];
const Section = value.variant === 'centered' ? FAQsAccordion : FAQsTwoColumnAccordion;
---
<Section id={value._key || 'faqs'} headline="Questions & Answers">
  {items.map((item, idx) => <Faq id={`faq-item-${idx}`} question={item.question} answer={item.answer} />)}
</Section>

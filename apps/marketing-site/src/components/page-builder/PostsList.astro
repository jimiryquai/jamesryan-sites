---
import type { StoredBlock } from 'emdash-plugin-page-builder/blocks';
import { markdownText } from 'emdash-plugin-page-builder/blocks';
import type { SitePost } from './sources';
interface Props { value: StoredBlock; items?: readonly unknown[] }
const value = Astro.props.value as StoredBlock & { heading?: string };
// PageBuilder resolves this block's typed source before entering the generic section boundary.
const posts = (Astro.props.items ?? []) as readonly SitePost[];
// Without a block heading, the section's own default label shows.
const heading = markdownText(value.heading) ?? 'Recent Posts';

function formatDate(date: Date | string | undefined) {
	if (date === undefined) return null;
	const value = typeof date === 'string' ? new Date(date) : date;
	return value.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---
{
	posts.length > 0 && (
		<section class="mx-auto w-full max-w-4xl px-6 lg:px-10 py-16 sm:py-24 font-sans">
			<div class="flex justify-between items-baseline mb-6">
				<h2 class="text-xs font-semibold tracking-widest uppercase text-olive-500 dark:text-olive-400">{heading}</h2>
				<a
					href="/posts"
					class="text-sm font-medium text-olive-900 dark:text-white hover:text-olive-700 dark:hover:text-olive-300 transition-colors duration-150"
				>
					View all posts &rarr;
				</a>
			</div>
			<div class="border-t border-olive-950/10 dark:border-white/10">
				{posts.map((post) => (
					<article class="group border-b border-olive-950/10 dark:border-white/10">
						<a href={post.url} class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-8">
							<div class="flex items-center gap-2 text-sm text-olive-600 dark:text-olive-400 sm:w-44 shrink-0">
								{formatDate(post.date) && <time class="whitespace-nowrap">{formatDate(post.date)}</time>}
								{formatDate(post.date) && <span class="w-1 h-1 rounded-full bg-olive-300 dark:bg-olive-700" />}
								<span class="whitespace-nowrap">{post.readingTime} min read</span>
							</div>
							<div class="flex-1">
								<h3 class="text-xl font-semibold tracking-tight text-olive-950 dark:text-white leading-snug group-hover:text-olive-700 dark:group-hover:text-olive-300 transition-colors duration-150">
									{post.title}
								</h3>
								{post.excerpt && (
									<p class="mt-2 text-base text-olive-700 dark:text-olive-400 leading-relaxed line-clamp-2">{post.excerpt}</p>
								)}
								{(post.tags?.length ?? 0) > 0 && (
									<div class="mt-3 flex flex-wrap gap-1.5">
										{post.tags!.map((tag) => (
											<span class="inline-block px-2.5 py-0.5 text-xs text-olive-700 dark:text-olive-300 bg-olive-950/2.5 dark:bg-white/5 border border-olive-950/5 dark:border-white/5 rounded-full">
												{tag.label}
											</span>
										))}
									</div>
								)}
							</div>
						</a>
					</article>
				))}
			</div>
		</section>
	)
}

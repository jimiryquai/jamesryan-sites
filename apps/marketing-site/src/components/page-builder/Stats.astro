---
import type { StoredBlock } from 'emdash-plugin-page-builder/blocks';
import StatsWithGraph from '@jamesryan/ui/components/sections/StatsWithGraph.astro';
import Stat from '@jamesryan/ui/components/sections/Stat.astro';
interface Props { value: StoredBlock }
const value = Astro.props.value as StoredBlock & {
  eyebrow?: string; heading?: string; body?: string; items?: { value?: string; label?: string }[];
};
---
<StatsWithGraph id={value._key || 'stats'} eyebrow={value.eyebrow} headline={value.heading} subheadline={value.body}>
  {(value.items ?? []).map((item) => <Stat stat={item.value ?? ''} text={item.label ?? ''} />)}
</StatsWithGraph>

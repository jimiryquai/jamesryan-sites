---
import type { StoredBlock } from 'emdash-plugin-page-builder/blocks';
import type { MediaValue } from 'emdash';
import { Image } from 'emdash/ui';
import { Icon } from 'astro-iconset/components';
import FeaturesTwoColumnWithDemos from '@jamesryan/ui/components/sections/FeaturesTwoColumnWithDemos.astro';
import FeaturesThreeColumn from '@jamesryan/ui/components/sections/FeaturesThreeColumn.astro';
import FeaturesThreeColumnWithDemos from '@jamesryan/ui/components/sections/FeaturesThreeColumnWithDemos.astro';
import FeaturesStackedAlternatingWithDemos from '@jamesryan/ui/components/sections/FeaturesStackedAlternatingWithDemos.astro';
import Feature from '@jamesryan/ui/components/sections/Feature.astro';
import FeatureThreeColumn from '@jamesryan/ui/components/sections/FeatureThreeColumn.astro';
import FeatureThreeColumnWithDemos from '@jamesryan/ui/components/sections/FeatureThreeColumnWithDemos.astro';
import StackedAlternatingFeature from '@jamesryan/ui/components/sections/StackedAlternatingFeature.astro';
import Link from '@jamesryan/ui/components/elements/link.astro';
import { veSection, ed } from './vx-edit';
interface Props { value: StoredBlock }
const value = Astro.props.value as StoredBlock & {
  heading?: string; subheadline?: string; eyebrow?: string;
  variant?: 'two-column' | 'three-column' | 'three-column-demos' | 'alternating';
  items?: { title: string; description?: string; icon?: string; image?: MediaValue; cta_label?: string; cta_url?: string }[];
};
// THROWAWAY SPIKE (ticket 25): text markers in the visual editor preview only.
const vx = Astro.locals.vxFrame === true;
const sections = {
  'two-column': [FeaturesTwoColumnWithDemos, Feature],
  'three-column': [FeaturesThreeColumn, FeatureThreeColumn],
  'three-column-demos': [FeaturesThreeColumnWithDemos, FeatureThreeColumnWithDemos],
  alternating: [FeaturesStackedAlternatingWithDemos, StackedAlternatingFeature],
} as const;
// Aliases accepted by the marketing editor, mapped to this site's bundled icons.
const icons: Record<string, string> = { mail: 'envelope', zap: 'lightning', shield: 'shield-check', users: 'users-three', chart: 'chart-bar', code: 'code', globe: 'globe', heart: 'heart', star: 'star', check: 'check', lock: 'lock', clock: 'clock', cloud: 'cloud' };
const compact = value.variant === 'three-column' || value.variant === 'three-column-demos';
const [Section, Item] = sections[value.variant ?? 'two-column'] ?? sections['two-column'];
---
<Section id={value._key} {...veSection(Astro.locals, value)}
  eyebrow={vx ? undefined : value.eyebrow} headline={vx ? undefined : value.heading} subheadline={vx ? undefined : value.subheadline}>
  {vx && value.eyebrow !== undefined && <span slot="eyebrow" {...ed(Astro.locals, value, 'eyebrow')}>{value.eyebrow}</span>}
  {vx && <span slot="headline" {...ed(Astro.locals, value, 'heading')}>{value.heading ?? ''}</span>}
  {vx && <span slot="subheadline" {...ed(Astro.locals, value, 'subheadline')}>{value.subheadline ?? ''}</span>}
  {(value.items ?? []).map((item, i) => <Item headline={vx ? undefined : item.title}>
    {vx && <span slot="headline" {...ed(Astro.locals, value, `items.${i}.title`)}>{item.title ?? ''}</span>}
    <div slot="subheadline" {...(vx ? ed(Astro.locals, value, `items.${i}.description`) : {})}>
      {item.description}
      {compact && item.cta_label && item.cta_url && <Link href={item.cta_url}>{item.cta_label}</Link>}
    </div>
    {icons[item.icon ?? ''] && <Icon slot="icon" name={`ph:${icons[item.icon ?? '']}`} class="size-4" />}
    {item.image && <Image slot="demo" image={item.image} width={1000} height={800} class="w-full h-auto" />}
    {!compact && item.cta_label && item.cta_url && <Link slot="cta" href={item.cta_url}>{item.cta_label}</Link>}
  </Item>)}
</Section>

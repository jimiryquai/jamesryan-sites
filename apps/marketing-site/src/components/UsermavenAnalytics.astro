---
import { env } from "cloudflare:workers";
import { USERMAVEN_PROXY_PATH, normalizeUsermavenKey } from "../utils/usermaven.ts";

const key = normalizeUsermavenKey(env.USERMAVEN_KEY);
const trackingHost = USERMAVEN_PROXY_PATH;
const scriptSrc = `${USERMAVEN_PROXY_PATH}/lib.js`;
---

{
	key && (
		<script is:inline define:vars={{ key, trackingHost, scriptSrc }}>
			window.usermaven =
				window.usermaven ||
				function () {
					(window.usermavenQ = window.usermavenQ || []).push(arguments);
				};
			var t = document.createElement("script"),
				s = document.getElementsByTagName("script")[0];
			t.defer = true;
			t.id = "um-tracker";
			t.setAttribute("data-tracking-host", trackingHost);
			t.setAttribute("data-key", key);
			t.setAttribute("data-autocapture", "true");
			t.setAttribute("data-privacy-policy", "strict");
			t.setAttribute("data-randomize-url", "true");
			t.src = scriptSrc;
			s.parentNode.insertBefore(t, s);
		</script>
	)
}

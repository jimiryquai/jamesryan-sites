---
import { getPublishedRoute } from "@jamesryan/cms-helpers";
import { getSiteSettings, getSeoMeta, getContentSeo } from "emdash";
import Base from "../layouts/Base.astro";
import PageLayout from "../components/page-builder/PageLayout.astro";
import { resolvePageLayout } from "../components/page-builder/resolve-page-layout";
import { getPublicOrigin } from "emdash/api/route-utils";
import { resolveFeaturedPostPreload } from "../components/page-builder/featured-post-preload";
import { resolveSiteIdentity } from "@jamesryan/cms-helpers";

const route = await getPublishedRoute("/", Astro.cache, { references: { service: true } });
if (route?.kind !== "entry" || route.collection !== "pages") return Astro.rewrite("/404");
const page = route.entry;
const pageLayout = resolvePageLayout(page);
const { siteTagline } = resolveSiteIdentity(await getSiteSettings(), { site: Astro.site, requestUrl: Astro.url });

const pageTitle = page.data.title;
const seo = getSeoMeta(page);
const homeSeo = getContentSeo(page);

// The featured post's image is Home's LCP: preload it when the layout's posts
// block features one. The read is shared with the section that renders it.
const preload = pageLayout
	? await resolveFeaturedPostPreload(pageLayout.layout.map((block) => ({ ...block })), pageLayout.group, getPublicOrigin(Astro.url, Astro.locals.emdash?.config))
	: undefined;
---

<Base
	title={homeSeo?.title ? seo?.ogTitle : (pageTitle !== "Home" ? pageTitle : undefined)}
	description={seo?.description ?? siteTagline}
	content={{ collection: "pages", id: page.data.id, slug: page.id }}
>
	{preload && (
		<link 
			rel="preload" 
			as="image" 
			href={preload.href}
			imagesrcset={preload.imagesrcset}
			imagesizes={preload.imagesizes}
			fetchpriority="high"
			slot="links" 
		/>
	)}

	{pageLayout && <PageLayout value={pageLayout.layout} group={pageLayout.group} edit={page.edit.layout} />}
</Base>

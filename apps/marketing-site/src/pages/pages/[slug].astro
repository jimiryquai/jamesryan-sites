---
import { decodeSlug } from "emdash";
import { getPublishedRoutes } from "@jamesryan/cms-helpers";
import PublishedPage from "../../components/PublishedPage.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const routes = await getPublishedRoutes(Astro.cache);
const page = routes.get(`/pages/${encodeURIComponent(slug)}`)?.entry;
if (!page) return Astro.rewrite("/404");
---
<PublishedPage page={page} />

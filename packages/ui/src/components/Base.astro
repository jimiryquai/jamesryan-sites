---
import {
	getMenuWithCacheHint,
	getSiteSettingsWithCacheHint,
} from "emdash";
import Seo from "@jdevalk/astro-seo-graph/Seo.astro";
import {
	buildWebPage,
	buildArticle,
	buildBreadcrumbList,
	buildImageObject,
	assembleGraph,
} from "@jdevalk/seo-graph-core";
import { buildSiteGraph } from "../utils/seo-graph.ts";
import { createPublicPageContext, getPageRuntime } from "emdash/page";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import themeScript from "./theme-init.js?raw";
import NavbarLink from "./sections/NavbarLink.astro";
import FooterLink from "./sections/FooterLink.astro";

import { renderPageFragments } from "../utils/page-fragments.ts";

interface Props {
	title?: string;
	pageTitle?: string;
	description?: string | null;
	image?: string;
	canonical?: string | null;
	robots?: string | null;
	type?: string;
	publishedTime?: string | null;
	modifiedTime?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	hideHeaderFooter?: boolean;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	content,
	hideHeaderFooter = false,
} = Astro.props;
const settingsResult = hideHeaderFooter ? null : await getSiteSettingsWithCacheHint();
const settings = settingsResult?.data;
if (settingsResult && Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);
const siteTitle = settings?.title || "Oatmeal";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription =
	settings?.tagline || "Customer support that feels like a conversation.";
// Null means an entry has no description; undefined uses the site default.
const resolvedDescription = description === null ? undefined : description || siteDescription;
const menuResult = hideHeaderFooter ? null : await getMenuWithCacheHint("primary");
const primaryMenu = menuResult?.data;
if (menuResult && Astro.cache?.enabled) Astro.cache.set(menuResult.cacheHint);

// Generate dynamic OG Image URL
const siteUrl = Astro.site?.origin || "https://oatmeal.dev";
const canonicalUrl =
	canonical || new URL(Astro.url.pathname, siteUrl).toString();
let ogImageUrl = `${siteUrl}/og/default.png`;
if (content) {
	let prefix = "pages";
	if (content.collection === "posts") {
		prefix = "posts";
	} else if (content.collection === "projects") {
		prefix = "projects";
	}
	ogImageUrl = `${siteUrl}/og/${prefix}/${content.slug || content.id}.png`;
}
const finalOgImage = image || ogImageUrl;

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: resolvedDescription,
	canonical: canonicalUrl,
	image: finalOgImage,
	seo: {
		ogImage: finalOgImage,
		robots: robots || undefined,
	},
	siteName: siteTitle,
	content,
});

// Run EmDash runtime logic to get plugin contributions and fragments
const runtime = getPageRuntime(
	Astro.locals as unknown as Record<string, unknown>,
);
const pluginContributions = runtime
	? await runtime.collectPageMetadata(pageCtx)
	: [];
const fragments = runtime ? await runtime.collectPageFragments(pageCtx) : [];

// Filter out standard SEO tags that <Seo> will output
const extraMeta: Array<Record<string, string>> = [];
const extraLinks: Array<Record<string, string>> = [];

let seoNoindex = robots?.includes("noindex") || false;

for (const c of pluginContributions) {
	if (c.kind === "meta") {
		if (
			c.name === "description" ||
			c.name === "robots" ||
			c.name.startsWith("twitter:")
		) {
			if (c.name === "robots" && c.content?.includes("noindex")) {
				seoNoindex = true;
			}
			continue;
		}
		extraMeta.push({ name: c.name, content: c.content });
	} else if (c.kind === "property") {
		if (c.property.startsWith("og:") || c.property.startsWith("twitter:")) {
			continue;
		}
		extraMeta.push({ property: c.property, content: c.content });
	} else if (c.kind === "link") {
		if (c.rel === "canonical" || c.hreflang) {
			continue;
		}
		extraLinks.push({
			rel: c.rel,
			href: c.href,
			...(c.hreflang && { hreflang: c.hreflang }),
		});
	}
}

// Add favicon to extra links if settings provides it
const faviconUrl = settings?.favicon?.url;
if (faviconUrl) {
	extraLinks.push({ rel: "icon", href: faviconUrl });
}

// Generate the JSON-LD schema graph
const { ids, blogId, pieces: sitePieces } = buildSiteGraph(siteUrl, siteTitle, siteDescription);

const segments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = [{ name: "Home", url: siteUrl }];
let runningPath = siteUrl;
segments.forEach((segment) => {
	runningPath += `/${segment}`;
	const name =
		segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, " ");
	breadcrumbItems.push({ name, url: runningPath });
});

const breadcrumbPiece = buildBreadcrumbList(
	{
		url: canonicalUrl,
		items: breadcrumbItems,
	},
	ids,
);

let webPageType: "WebPage" | "ProfilePage" | "CollectionPage" = "WebPage";
if (type === "collection" || type === "CollectionPage") {
	webPageType = "CollectionPage";
} else if (type === "profile" || type === "ProfilePage") {
	webPageType = "ProfilePage";
}

const webPagePiece = buildWebPage(
	{
		url: canonicalUrl,
		name: title || pageTitle || siteTitle,
		isPartOf: { "@id": ids.website },
		breadcrumb: { "@id": ids.breadcrumb(canonicalUrl) },
		inLanguage: "en-US",
		datePublished: publishedTime ? new Date(publishedTime) : undefined,
		dateModified: modifiedTime ? new Date(modifiedTime) : undefined,
		primaryImage: finalOgImage
			? { "@id": ids.primaryImage(canonicalUrl) }
			: undefined,
	},
	ids,
	webPageType,
);

const primaryImagePiece = finalOgImage
	? buildImageObject(
			{
				pageUrl: canonicalUrl,
				url: finalOgImage,
				width: 1200,
				height: 630,
			},
			ids,
		)
	: null;

const articlePiece =
	type === "article"
		? buildArticle(
				{
					url: canonicalUrl,
					isPartOf: [
						{ "@id": ids.webPage(canonicalUrl) },
						{ "@id": blogId },
					] as unknown as { "@id": string },
					author: { "@id": ids.person },
					publisher: { "@id": ids.person },
					headline: title || pageTitle || siteTitle,
					description: resolvedDescription || "",
					datePublished: publishedTime
						? new Date(publishedTime)
						: new Date(),
					dateModified: modifiedTime
						? new Date(modifiedTime)
						: undefined,
					image: finalOgImage
						? { "@id": ids.primaryImage(canonicalUrl) }
						: undefined,
				},
				ids,
				"BlogPosting",
			)
		: null;

const pieces: any[] = [
	...sitePieces,
	webPagePiece,
	breadcrumbPiece,
];
if (primaryImagePiece) pieces.push(primaryImagePiece);
if (articlePiece) pieces.push(articlePiece);

const graph = assembleGraph(pieces, { warnOnDanglingReferences: true });

const fragmentHtml = renderPageFragments(fragments);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Seo
			title={fullTitle}
			description={resolvedDescription}
			canonical={canonicalUrl}
			ogType={type === "article" ? "article" : "website"}
			ogImage={finalOgImage}
			siteName={siteTitle}
			graph={graph}
			noindex={seoNoindex}
			extraLinks={extraLinks}
			extraMeta={extraMeta}
		/>
		<Fragment set:html={fragmentHtml.head} />
		<slot name="links" />
		<script is:inline set:html={themeScript} />
	</head>
	<body
		class="flex flex-col min-h-screen bg-olive-100 text-olive-950 antialiased dark:bg-olive-950 dark:text-white transition-colors duration-200"
	>
		<Fragment set:html={fragmentHtml["body:start"]} />
		{
			!hideHeaderFooter && (
				<header
					class="sticky top-0 z-10 bg-olive-100/80 backdrop-blur-md dark:bg-olive-950/80 border-b border-olive-950/5 dark:border-white/5"
					id="navbar"
				>
					<nav class="mx-auto flex h-16 max-w-7xl items-center justify-center px-6 lg:px-10">
						<ul class="flex items-center gap-x-8">
							{primaryMenu?.items.map((item) => (
								<li>
									<NavbarLink
										href={item.url}
										class="!text-sm/7"
									>
										{item.label}
									</NavbarLink>
								</li>
							))}
						</ul>
						<ThemeSwitcher />
					</nav>
				</header>
			)
		}

		<main class="flex-grow">
			<slot />
		</main>

		{
			!hideHeaderFooter && (
				<footer class="py-12" id="footer">
					<div class="mx-auto max-w-7xl px-6 lg:px-10 relative flex flex-col md:flex-row md:items-center justify-center gap-y-4 text-sm font-sans">
						<div class="md:absolute md:left-6 lg:left-10 text-olive-600 dark:text-olive-400 whitespace-nowrap">
							&copy; {new Date().getFullYear()} {siteTitle}. All
							rights reserved.
						</div>
						<nav>
							<ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2">
								{primaryMenu?.items.map((item) => (
									<FooterLink href={item.url}>
										{item.label}
									</FooterLink>
								))}
							</ul>
						</nav>
					</div>
				</footer>
			)
		}
		<Fragment set:html={fragmentHtml["body:end"]} />
	</body>
</html>

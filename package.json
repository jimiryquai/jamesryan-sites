{
  "name": "jamesryan-sites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter marketing-site dev",
    "dev:garden": "pnpm --filter digital-garden dev",
    "dev:all": "pnpm --parallel dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@jdevalk/astro-seo-graph": "2.2.0",
    "mcporter": "0.17.0",
    "playwright": "1.65.0"
  }
}
